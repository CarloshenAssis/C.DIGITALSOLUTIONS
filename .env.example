# ---------------------------------------------------------------------------
# C. DIGITAL SOLUTIONS
# Copie para .env.local (desenvolvimento) ou configure na Vercel (produção).
# Nenhuma destas variáveis é obrigatória para o site funcionar.
# ---------------------------------------------------------------------------

# Domínio final. Usado em metadata, canonical, sitemap e JSON-LD.
#
# Opcional: sem esta variável, o domínio de produção da Vercel é detectado
# automaticamente (ver src/config/site-url.ts). Se for definir, defina com um
# valor — uma variável declarada e VAZIA é tratada como ausente, nunca como
# domínio.
NEXT_PUBLIC_SITE_URL="https://cdigitalsolutions.com.br"

# Endpoint que recebe o briefing do formulário de contato.
# Aceita qualquer serviço que receba POST com JSON: Formspree, n8n,
# Resend via rota própria, Google Apps Script, Supabase Edge Function.
# Sem esta variável, o formulário valida e entrega o briefing pelo canal
# direto configurado em src/config/contact.ts.
CONTACT_WEBHOOK_URL=""
